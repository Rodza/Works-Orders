RewriteEngine On

# Proper MIME types for JS modules
AddType application/javascript .js
AddType application/json .json

# Handle API requests - serve PHP files directly
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ api/$1 [L]

# Check if file exists in dist/ folder first (built assets take priority)
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.*)$ dist/$1 [L]

# SPA fallback - everything else goes to dist/index.html
RewriteRule ^ dist/index.html [L]
