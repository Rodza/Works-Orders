RewriteEngine On

# Force MIME types
AddType application/javascript .js .mjs
AddType application/json .json

# Disable DirectoryIndex so root index.html is not auto-served
DirectoryIndex disabled

# Handle API requests - serve PHP files directly
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ api/$1 [L]

# Serve files from dist/ using relative path
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/dist/
RewriteCond dist/%{REQUEST_URI} -f
RewriteRule ^(.*)$ dist/$1 [L]

# SPA fallback - everything else goes to dist/index.html
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^ dist/index.html [L]
